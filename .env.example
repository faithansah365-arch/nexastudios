# APP_URL: Public base URL of the NexaStudios deployment
APP_URL="http://localhost:3000"

# SESSION_SECRET: Random 32+ byte hex secret for signing/hashing session cookies
# Set this in Vercel Environment Variables so sessions remain valid across serverless cold starts
SESSION_SECRET=""

# MONGODB_URI: MongoDB Atlas connection string (mongodb+srv://...)
# When omitted in local dev, NexaStudios falls back to local SQLite (data/nexaflow.db)
MONGODB_URI=""
MONGODB_DB_NAME="nexaflow_studio"

# GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET: Standard Google OAuth 2.0 credentials for Sign-In (MongoDB-backed, no Firebase)
# Authorized redirect URI: <YOUR_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# GEMINI_API_KEY: Server-side Gemini API key for AI Teleprompter script & pacing generation
GEMINI_API_KEY=""

# PAYSTACK_SECRET_KEY & PAYSTACK_PUBLIC_KEY: Optional Paystack test/live API keys
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# INITIAL_ADMIN_PROVISION_TOKEN: Optional one-time token for creating the first /admin account
INITIAL_ADMIN_PROVISION_TOKEN=""
