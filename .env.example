# APP_URL: Public base URL of the NexaFlow AI Studio deployment
APP_URL="http://localhost:3000"

# SESSION_SECRET: Random 32+ byte hex secret for signing/hashing session cookies
# If omitted in local dev, the server generates and persists a secret in data/.session_secret
SESSION_SECRET=""

# MONGODB_URI: Optional MongoDB Atlas connection string (mongodb+srv://...)
# When omitted, NexaFlow runs with zero external cost using local SQLite (data/nexaflow.db)
MONGODB_URI=""
MONGODB_DB_NAME="nexaflow_studio"

# PAYSTACK_SECRET_KEY & PAYSTACK_PUBLIC_KEY: Optional Paystack test/live API keys
# Leave blank until Paystack credentials are configured in Admin Settings or environment
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# INITIAL_ADMIN_PROVISION_TOKEN: Optional one-time token for creating the first /admin account
# If omitted, a random one-time token is generated on startup into data/admin-bootstrap.token
INITIAL_ADMIN_PROVISION_TOKEN=""
